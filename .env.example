# PearProgramming environment reference
# Copy only the variables needed by the service you are running.

# Backend: Spring API/STOMP service
SERVER_PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pearprogram
SPRING_DATASOURCE_USERNAME=pearprogram
SPRING_DATASOURCE_PASSWORD=pearprogram
SPRING_DATASOURCE_MAX_POOL_SIZE=10
SPRING_DATASOURCE_MIN_IDLE=1
SPRING_DATASOURCE_CONNECTION_TIMEOUT_MS=10000
PEARPROGRAM_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://pear-programming.vercel.app,https://*.vercel.app
AUTH_SESSION_TIMEOUT=12h
# Use true with HTTPS. Cross-site frontend/backend deployments also require SameSite=none.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_REALTIME_TOKEN_TTL=10m
# Set the same high-entropy value on backend and realtime in non-loopback deployments.
INTERNAL_SERVICE_TOKEN=
ROOM_CLEANUP_GRACE_SECONDS=120
ROOM_CLEANUP_SCAN_MS=5000
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_USERNAME=
SPRING_REDIS_PASSWORD=
SPRING_REDIS_SSL=false
SPRING_REDIS_TIMEOUT=10s
SPRING_REDIS_POOL_MAX_WAIT=5s

# Preferred production backend Redis TCP URL, e.g. rediss://default:PASSWORD@HOST:6379
SPRING_REDIS_URL=
PEARPROGRAM_REDIS_KEY_PREFIX=pearprogram
PEARPROGRAM_REDIS_CONNECTION_INITIAL_DELAY_MS=5000
PEARPROGRAM_REDIS_CONNECTION_RETRY_MS=30000
PEARPROGRAM_REALTIME_REDIS_BROADCAST_ENABLED=true
PEARPROGRAM_REALTIME_REDIS_BROADCAST_RETRY_MS=30000
SPRING_REDIS_HEALTH_ENABLED=false
PEARPROGRAM_AI_PLACEHOLDER=false

# Sandboxed execution: self-hosted Judge0 needs only JUDGE0_BASE_URL.
# Hosted RapidAPI-compatible Judge0 also uses JUDGE0_API_KEY and JUDGE0_API_HOST.
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_REQUEST_TIMEOUT=5s
JUDGE0_EXECUTION_TIMEOUT_SECONDS=5
JUDGE0_EXECUTION_DEADLINE=20s
JUDGE0_POLL_INTERVAL=750ms
JUDGE0_MAX_POLL_ATTEMPTS=25
JUDGE0_MAX_RETRIES=2
JUDGE0_RETRY_BACKOFF=200ms
EXECUTION_MAX_SOURCE_BYTES=100000
EXECUTION_MAX_STDIN_BYTES=20000
EXECUTION_RATE_LIMIT_PER_MINUTE=10
EXECUTION_RECORD_TTL=15m
EXECUTION_WORKER_THREADS=4
EXECUTION_WORKER_POLL_INTERVAL=200ms
EXECUTION_WORKER_LEASE=30s
EXECUTION_WORKER_MAX_RETRIES=3
EXECUTION_WORKER_RETRY_BACKOFF=1s
EXECUTION_WORKER_RECOVERY_INTERVAL=5s


GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

#these below groq env vars are actually not really necessary 
GROQ_MAX_COMPLETION_TOKENS=220
GROQ_TEMPERATURE=0.3 

# Realtime: Node y-websocket service
PORT=1235
# Set true in production so /readyz fails until Redis persistence and pub/sub are connected.
REQUIRE_REDIS=false
INTERNAL_SERVICE_TOKEN=
AUTH_VALIDATION_ENDPOINT=http://localhost:8081/internal/auth/realtime/validate
SNAPSHOT_ENDPOINT=http://localhost:8081/internal/files
ROOM_CLEANUP_ENDPOINT=http://localhost:8081/internal/rooms
ROOM_CLEANUP_GRACE_MS=120000
SNAPSHOT_INTERVAL_MS=30000
ROOM_TTL_SECONDS=86400

# Preferred for Upstash/TLS Redis: rediss://default:PASSWORD@HOST:6379
REDIS_URL=
REDIS_KEY_PREFIX=pearprogram

# Local Redis alternative when REDIS_URL is not set:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Frontend: Vite app
VITE_API_URL=http://localhost:8081
VITE_STOMP_URL=http://localhost:8081/ws
VITE_YJS_URL=ws://localhost:1235

# Optional local frontend proxy. Use this when previewing against a deployed backend
# whose production CORS allowlist intentionally excludes localhost. Point the two
# public frontend URLs above at http://localhost:5174 when this proxy is enabled.
VITE_DEV_PROXY_TARGET=
VITE_DEV_PROXY_ORIGIN=

# Cross-device local testing example:
# VITE_API_URL=http://YOUR_LAN_IP:8081
# VITE_STOMP_URL=http://YOUR_LAN_IP:8081/ws
# VITE_YJS_URL=ws://YOUR_LAN_IP:1235
