# Spring
# Local Postgres example: jdbc:postgresql://localhost:5432/pearprogram
# Supabase example: jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pearprogram
SPRING_DATASOURCE_USERNAME=pear
SPRING_DATASOURCE_PASSWORD=pear
SPRING_PROFILES_ACTIVE=postgres
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=
SPRING_REDIS_SSL=false
SPRING_JPA_HIBERNATE_DDL_AUTO=update
JWT_SECRET=dev-only-change-me-dev-only-change-me
SERVER_PORT=8081
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_COMPLETION_TOKENS=220
GROQ_TEMPERATURE=0.3
YJS_SERVER_URL=ws://localhost:1235
PEARPROGRAM_AI_PLACEHOLDER=true
PEARPROGRAM_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app

# Node y-websocket
# This service uses ioredis, so Upstash must use the TCP URL, not REST credentials.
# Preferred for Upstash/TLS Redis: rediss://default:PASSWORD@HOST:6379
REDIS_URL=
# Do not use UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN with this service unless the client changes to @upstash/redis.
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_TLS=false
SPRING_AUTH_URL=http://localhost:8081/auth/validate
SNAPSHOT_ENDPOINT=http://localhost:8081/internal/files
ROOM_CLEANUP_ENDPOINT=http://localhost:8081/internal/rooms
ROOM_CLEANUP_GRACE_MS=20000
PORT=1235
ALLOW_ANONYMOUS=true
SNAPSHOT_INTERVAL_MS=30000
ROOM_TTL_SECONDS=86400

# Frontend
VITE_API_BASE_URL=http://localhost:8081
VITE_STOMP_URL=http://localhost:8081/ws
VITE_YJS_URL=ws://localhost:1235

# Cross-device local testing example:
# VITE_API_BASE_URL=http://YOUR_LAN_IP:8081
# VITE_STOMP_URL=http://YOUR_LAN_IP:8081/ws
# VITE_YJS_URL=ws://YOUR_LAN_IP:1235
