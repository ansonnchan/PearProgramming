# Copy to .env.production, replace every change-me value, and never commit that file.

# Public HTTPS origin. PUBLIC_APP_HOST must not include a scheme or path.
PUBLIC_APP_HOST=pear.example.com
PUBLIC_APP_ORIGIN=https://pear.example.com
CADDY_ACME_EMAIL=ops@example.com

# Durable stores used by docker-compose.production.yml.
POSTGRES_DB=pearprogram
POSTGRES_USER=pearprogram
POSTGRES_PASSWORD=change-me-long-random-postgres-password
REDIS_PASSWORD=change-me-long-random-redis-password

# Shared only by Spring and the realtime service.
INTERNAL_SERVICE_TOKEN=change-me-at-least-32-random-bytes

# Cookie sessions remain same-origin behind Caddy.
AUTH_SESSION_TIMEOUT=12h
AUTH_REALTIME_TOKEN_TTL=10m

# Judge0-compatible provider. Keep these values server-side.
JUDGE0_BASE_URL=https://judge0.example.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_REQUEST_TIMEOUT=5s
JUDGE0_EXECUTION_TIMEOUT_SECONDS=5
JUDGE0_EXECUTION_DEADLINE=20s

# Optional AI completion provider. Leave GROQ_API_KEY empty to disable live AI completions.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Runtime sizing. Tune these to the host and Judge0 quota.
SPRING_DATASOURCE_MAX_POOL_SIZE=10
EXECUTION_WORKER_THREADS=4
EXECUTION_RATE_LIMIT_PER_MINUTE=10
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
